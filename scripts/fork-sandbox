#!/usr/bin/env bash
# fork-sandbox — Git-style dispatcher for the fork-sandbox porcelain
#
# Usage: fork-sandbox run [options] <project-path> <handoff-file>
#        fork-sandbox status [options] <run-dir>
#        fork-sandbox say <run-dir> <message>
#        fork-sandbox k8s <sub-verb> [options]
#        fork-sandbox log <sub-verb> [options]
#        fork-sandbox configure [options]
#        fork-sandbox validate-services <file>
#
# Each verb routes to the script that implements it, and every one of those
# scripts stays installed and callable under its own name:
#
#   run        fork-sandbox.sh
#   status     fork-sandbox-status.sh
#   say        fork-sandbox-say.sh
#   k8s        fork-sandbox-k8s.sh
#   log        sandbox-run-log.py
#   configure  fork-sandbox.sh configure
#   validate-services  fork-sandbox-k8s-services-parse.py
#
# The dispatcher parses nothing of its own beyond a leading -h/--help, so a
# --help after a verb reaches that verb's script and the sub-verbs of k8s
# and log pass straight through. The lkml-mode toolchain (lkml-*.sh,
# lkml-render.py) is deliberately outside the dispatcher.

set -euo pipefail

usage() {
    sed -n '2,/^[^#]/{ /^#/s/^# \?//p }' "$0"
}

script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

if (($# == 0)); then
    usage >&2
    exit 2
fi

if [[ "$1" == '-h' || "$1" == '--help' ]]; then
    usage
    exit 0
fi

verb="$1"
shift

case "$verb" in
    run)
        target='fork-sandbox.sh'
        ;;
    status)
        target='fork-sandbox-status.sh'
        ;;
    say)
        target='fork-sandbox-say.sh'
        ;;
    configure)
        target='fork-sandbox.sh'
        set -- configure "$@"
        ;;
    k8s)
        target='fork-sandbox-k8s.sh'
        ;;
    log)
        target='sandbox-run-log.py'
        ;;
    validate-services)
        target='fork-sandbox-k8s-services-parse.py'
        ;;
    *)
        printf "fork-sandbox: unknown verb '%s'\n" "$verb" >&2
        printf '%s\n' 'Verbs: run status say configure k8s log validate-services' >&2
        printf '%s\n' "Try 'fork-sandbox --help'." >&2
        exit 2
        ;;
esac

if [[ ! -x "$script_dir/$target" ]]; then
    printf 'fork-sandbox: cannot execute %s in %s\n' "$target" "$script_dir" >&2
    exit 127
fi

exec "$script_dir/$target" "$@"
