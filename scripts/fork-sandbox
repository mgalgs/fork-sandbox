#!/usr/bin/env bash
# fork-sandbox — Git-style dispatcher for the fork-sandbox porcelain
#
# Usage: fork-sandbox run [options] <project-path> <handoff-file>
#        fork-sandbox status [options] <run-dir>
#        fork-sandbox say <run-dir> <message>
#        fork-sandbox stop [--timeout SECS] <run-dir>
#        fork-sandbox adopt <run-dir>
#        fork-sandbox k8s <sub-verb> [options]
#        fork-sandbox log <sub-verb> [options]
#        fork-sandbox configure [options]
#        fork-sandbox validate-services <file>
#        fork-sandbox mail <verb> [options]
#        fork-sandbox mail-api <serve|mint|check> [options]
#        fork-sandbox mail-forward <--setup ...|--status|--stop>
#        fork-sandbox fleet <verb> [options]
#        fork-sandbox postmaster <verb> [options]
#
# Each verb routes to the script that implements it, and every one of those
# scripts stays installed and callable under its own name:
#
#   run        fork-sandbox.sh
#   status     fork-sandbox-status.sh
#   say        fork-sandbox-say.sh
#   stop       fork-sandbox-stop.sh
#   k8s        fork-sandbox-k8s.sh
#   adopt      fork-sandbox-k8s.sh adopt --run-dir
#   log        sandbox-run-log.py
#   configure  fork-sandbox.sh configure
#   validate-services  fork-sandbox-k8s-services-parse.py
#   mail       fork-sandbox-mail.sh
#   mail-api   fork-sandbox-mail-api.py
#   mail-forward  fork-sandbox-mail-forward.py
#   fleet      fork-sandbox-fleet.sh
#   postmaster fork-sandbox-postmaster.sh
#
# The dispatcher parses nothing of its own beyond a leading -h/--help, so a
# --help after a verb reaches that verb's script and the sub-verbs of k8s
# and log pass straight through.
#
# adopt <run-dir> is the one verb this dispatcher rewrites, the same way it
# rewrites `configure`: it is `fork-sandbox-k8s.sh adopt --run-dir
# <run-dir>` under a short, positional-argument name, for a caller
# re-adopting a --k8s run whose own host-side driver died (a restart, an
# evicted client) while its pod kept working. See `fork-sandbox-k8s.sh
# adopt`'s own header and "Re-adopting a run whose host-side driver died" in
# docs/kubernetes-runs.md for what it actually does.

set -euo pipefail

usage() {
    sed -n '2,/^[^#]/{ /^#/s/^# \?//p }' "$0"
}

script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

if (($# == 0)); then
    usage >&2
    exit 2
fi

if [[ "$1" == '-h' || "$1" == '--help' ]]; then
    usage
    exit 0
fi

verb="$1"
shift

case "$verb" in
    run)
        target='fork-sandbox.sh'
        ;;
    status)
        target='fork-sandbox-status.sh'
        ;;
    say)
        target='fork-sandbox-say.sh'
        ;;
    stop)
        target='fork-sandbox-stop.sh'
        ;;
    adopt)
        target='fork-sandbox-k8s.sh'
        # A plain `-h`/`--help` right after the verb must reach cmd_adopt's
        # own help text, not get swallowed as --run-dir's value (which a
        # blind `set -- adopt --run-dir "$@"` would do here, turning
        # `fork-sandbox adopt --help` into a doomed lookup for a run
        # directory literally named "--help"). A caller with no argument at
        # all still rewrites to `adopt --run-dir` with nothing after it --
        # cmd_adopt's own arg parser reports that cleanly.
        if [[ "${1-}" == '-h' || "${1-}" == '--help' ]]; then
            set -- adopt --help
        else
            set -- adopt --run-dir "$@"
        fi
        ;;
    configure)
        target='fork-sandbox.sh'
        set -- configure "$@"
        ;;
    k8s)
        target='fork-sandbox-k8s.sh'
        ;;
    log)
        target='sandbox-run-log.py'
        ;;
    validate-services)
        target='fork-sandbox-k8s-services-parse.py'
        ;;
    mail)
        target='fork-sandbox-mail.sh'
        ;;
    mail-api)
        target='fork-sandbox-mail-api.py'
        ;;
    mail-forward)
        target='fork-sandbox-mail-forward.py'
        ;;
    fleet)
        target='fork-sandbox-fleet.sh'
        ;;
    postmaster)
        target='fork-sandbox-postmaster.sh'
        ;;
    *)
        printf "fork-sandbox: unknown verb '%s'\n" "$verb" >&2
        printf '%s\n' 'Verbs: run status say stop adopt configure k8s log validate-services mail mail-api mail-forward fleet postmaster' >&2
        printf '%s\n' "Try 'fork-sandbox --help'." >&2
        exit 2
        ;;
esac

if [[ ! -x "$script_dir/$target" ]]; then
    printf 'fork-sandbox: cannot execute %s in %s\n' "$target" "$script_dir" >&2
    exit 127
fi

exec "$script_dir/$target" "$@"
