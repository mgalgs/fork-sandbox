#!/usr/bin/env python3
"""lane-mail-alert -- Turn Alertmanager and Grafana alert webhooks into lane mail

Usage: lane-mail-alert serve --listen HOST:PORT --token-file FILE [options]
       lane-mail-alert ingest [options] < payload.json
       lane-mail-alert --help

Options (both modes):
  --to LIST        recipients, comma-separated lane addresses; `@lane:host`
                   delivers to a peer host as `lane-mail.sh send` does
                   (default @ops)
  --from ADDR      the sending lane, a lane on this host (default @alerts)
  --state-dir DIR  where threading state lives (default
                   $XDG_STATE_HOME/fork-sandbox/lane-mail-alert, or
                   ~/.local/state/fork-sandbox/lane-mail-alert)
  --reopen SECS    a group that fires again within SECS of resolving
                   continues its old thread (default 3600; 0 never)
  --via STORE      where the mail goes: lane (default) sends with
                   lane-mail.sh; fleet sends with fork-sandbox-mail.sh to
                   the store at $FORK_SANDBOX_MAIL_ROOT, for running beside a
                   postmaster; remote sends through the mail API
                   (fork-sandbox-mail-remote.py, configured as for
                   `fork-sandbox mail --remote`). Only lane takes
                   `@lane:host` addresses.
  --route LABEL=VALUE:LIST
                   repeatable: a group whose common labels have LABEL=VALUE
                   goes to LIST instead of --to. The first matching route
                   wins (e.g. --route namespace=shop:@shop).

serve only:
  --heartbeat SECS treat the always-firing --heartbeat-alert (default
                   Watchdog) as a dead-man's switch: it is never mailed, and
                   when none has arrived for SECS (counting from startup) the
                   bridge mails --to an `[FIRING:1] AlertingQuiet` alert, and
                   its `[RESOLVED]` once the heartbeat returns

The bridge from a monitoring system to a lane-mail inbox (docs/agent-mail.md,
"Alerts into lane mail"). An Alertmanager webhook receiver and a Grafana
webhook contact point both POST the same JSON shape: one alert GROUP per
request, with a groupKey, a status, and a list of alerts. Each request becomes
at most one message, sent with this checkout's lane-mail.sh, so it lands in
the fixed lane-mail store and wakes whatever watches the recipient lanes.

Threading. A group's first notification opens a thread. Its later
notifications (an alert joined or left the group, the group resolved) reply
in that thread, so `[RESOLVED]` lands under its `[FIRING]`. A group that
resolved and fires again within --reopen seconds also continues its old
thread: a flapping alert is one thread, not a thread per flap. After that, a
new firing opens a new thread. A notification identical to the group's last
one (same status, same set of firing alerts) is dropped as a duplicate:
Alertmanager re-sends a firing group every repeat_interval, and an HA pair
can send the same group twice, and neither should wake anyone again.

Every message carries `X-Alert-Group: <16 hex>` (a hash of the groupKey) and
`X-Alert-Status: firing|resolved`, so `lane-mail.sh list --header
'X-Alert-Group: <hash>'` finds a group's threads. The state, one small JSON
file per group under --state-dir, is the bridge's own memory of where each
group's thread is; deleting it only means the next notification opens a new
thread.

serve listens for plain HTTP on --listen and authenticates every request
with `Authorization: Bearer <token>`, the token being the --token-file's
contents (whitespace stripped, at least 16 characters). It handles one
request at a time.

    GET  /healthz    no auth; 200 "ok"
    POST /v1/alert   the webhook JSON, at most 1 MiB

The reply is JSON: 200 {"result": "sent"|"replied"|"duplicate", "id",
"thread", "group"} once the message is stored (or dropped as a duplicate); 400
for a payload that is not a webhook (not retried by the sender); 401 for a
missing or wrong token; 500 when lane-mail.sh failed, which Alertmanager and
Grafana both retry.

ingest handles ONE payload from stdin the same way and prints the same JSON
on stdout: exit 0 when handled, 2 for a bad payload, 1 when sending failed.

The heartbeat covers what an alert cannot report: the alerting pipeline
itself going down. Run it on a bridge OUTSIDE the cluster whose alerts it
watches, and route only the heartbeat alert to it. A heartbeat-only
notification answers 200 {"result": "heartbeat"}.
"""

import argparse
import fcntl
import hashlib
import hmac
import json
import os
import re
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

SCRIPT_DIR = Path(os.path.realpath(__file__)).parent
VIA = {
    "lane": [str(SCRIPT_DIR / "lane-mail.sh")],
    "fleet": [str(SCRIPT_DIR / "fork-sandbox-mail.sh")],
    "remote": [str(SCRIPT_DIR / "fork-sandbox-mail-remote.py"), "mail"],
}
MAX_BODY = 1 << 20
MAX_LISTED = 20
ADDR_RE = re.compile(r"^@[a-z0-9][a-z0-9-]*(:[a-z0-9][a-z0-9.-]*)?$")
LOCAL_ADDR_RE = re.compile(r"^@[a-z0-9][a-z0-9-]*$")


class BadPayload(Exception):
    pass


class SendFailed(Exception):
    pass


def oneline(s, limit=200):
    s = re.sub(r"[\x00-\x1f\x7f]+", " ", str(s)).strip()
    return s[:limit]


def default_state_dir():
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "fork-sandbox", "lane-mail-alert")


def alert_fingerprint(alert):
    fp = alert.get("fingerprint")
    if isinstance(fp, str) and fp:
        return oneline(fp, 64)
    labels = alert.get("labels") or {}
    blob = json.dumps(labels, sort_keys=True).encode()
    return hashlib.sha256(blob).hexdigest()[:16]


def parse(payload):
    """Validates a webhook payload; returns (group_hash, status, alerts)."""
    if not isinstance(payload, dict):
        raise BadPayload("payload is not a JSON object")
    alerts = payload.get("alerts")
    if not isinstance(alerts, list) or not alerts:
        raise BadPayload("payload has no alerts list")
    for a in alerts:
        if not isinstance(a, dict):
            raise BadPayload("an alert is not a JSON object")
        for key in ("labels", "annotations"):
            if not isinstance(a.get(key) or {}, dict):
                raise BadPayload(f"an alert's {key} is not a JSON object")
    status = payload.get("status")
    if status not in ("firing", "resolved"):
        raise BadPayload("status is neither firing nor resolved")
    key = payload.get("groupKey")
    if not isinstance(key, str) or not key:
        key = json.dumps(payload.get("groupLabels") or
                         payload.get("commonLabels") or {}, sort_keys=True)
    group = hashlib.sha256(key.encode()).hexdigest()[:16]
    return group, status, alerts


def subject_for(payload, status, alerts):
    group_labels = payload.get("groupLabels") or {}
    if not isinstance(group_labels, dict) or not group_labels:
        common = payload.get("commonLabels") or {}
        name = common.get("alertname") if isinstance(common, dict) else None
        group_labels = {"alertname": name} if name else {}
    parts = []
    if "alertname" in group_labels:
        parts.append(str(group_labels["alertname"]))
    parts += [str(v) for k, v in sorted(group_labels.items())
              if k != "alertname"]
    title = " ".join(parts) or "alert group"
    if status == "firing":
        n = sum(1 for a in alerts if a.get("status", "firing") == "firing")
        tag = f"[FIRING:{n}]"
    else:
        tag = "[RESOLVED]"
    return oneline(f"{tag} {title}")


def indent_value(value):
    lines = str(value).rstrip("\n").split("\n")
    return "\n".join([lines[0]] + ["      " + ln for ln in lines[1:]])


def body_for(payload, group, status, alerts):
    firing = [a for a in alerts if a.get("status", "firing") == "firing"]
    out = [f"Status: {status} ({len(firing)} firing, "
           f"{len(alerts) - len(firing)} resolved)"]
    group_labels = payload.get("groupLabels") or {}
    if isinstance(group_labels, dict) and group_labels:
        out.append("Group: " + ", ".join(
            f"{k}={v}" for k, v in sorted(group_labels.items())))
    for key, label in (("receiver", "Receiver"), ("externalURL", "Source")):
        if payload.get(key):
            out.append(f"{label}: {oneline(payload[key], 500)}")
    for a in alerts[:MAX_LISTED]:
        labels = a.get("labels") or {}
        annotations = a.get("annotations") or {}
        out.append("")
        out.append(f"[{a.get('status', 'firing')}] "
                   f"{labels.get('alertname', '(no alertname)')}")
        for k, v in sorted(annotations.items()):
            out.append(f"  {k}: {indent_value(v)}")
        rest = {k: v for k, v in labels.items() if k != "alertname"}
        if rest:
            out.append("  labels: " + ", ".join(
                f"{k}={v}" for k, v in sorted(rest.items())))
        if a.get("startsAt"):
            out.append(f"  started: {a['startsAt']}")
        if a.get("status") == "resolved" and a.get("endsAt"):
            out.append(f"  ended: {a['endsAt']}")
        if a.get("valueString"):
            out.append(f"  values: {oneline(a['valueString'], 500)}")
        for key, label in (("generatorURL", "source"),
                           ("dashboardURL", "dashboard"),
                           ("panelURL", "panel"),
                           ("silenceURL", "silence")):
            if a.get(key):
                out.append(f"  {label}: {oneline(a[key], 500)}")
    hidden = len(alerts) - MAX_LISTED
    truncated = payload.get("truncatedAlerts") or 0
    if hidden > 0 or truncated:
        out.append("")
        out.append(f"({max(hidden, 0) + int(truncated)} more alerts "
                   "not shown)")
    out.append("")
    out.append(f"-- lane-mail-alert, group {group}: later notifications for "
               "this group reply in this thread.")
    return "\n".join(out) + "\n"


def run_mail(cmd, args, body):
    try:
        proc = subprocess.run([*cmd, *args], input=body,
                              capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise SendFailed(oneline(e))
    if proc.returncode != 0:
        raise SendFailed(oneline(proc.stderr or f"exit {proc.returncode}"))
    lines = proc.stdout.strip().splitlines()
    if not lines:
        raise SendFailed("the mail command printed no message id")
    return lines[-1].strip()


def parse_route(spec):
    """'LABEL=VALUE:@a[,@b]' -> (label, value, '@a,@b'), or None."""
    match, sep, addrs = spec.partition(":@")
    label, eq, value = match.partition("=")
    if not sep or not eq or not label or not value:
        return None
    return label, value, "@" + addrs


class Bridge:
    def __init__(self, to, sender, state_dir, reopen, via="lane",
                 routes=(), heartbeat=0, heartbeat_alert="Watchdog"):
        self.to = to
        self.sender = sender
        self.state_dir = Path(state_dir)
        self.reopen = reopen
        self.cmd = VIA[via]
        self.routes = list(routes)
        self.heartbeat = heartbeat
        self.heartbeat_alert = heartbeat_alert
        self.hb_lock = threading.Lock()
        self.hb_last = time.time()
        self.hb_quiet = False

    def recipients(self, payload):
        labels = {}
        for key in ("groupLabels", "commonLabels"):
            if isinstance(payload.get(key), dict):
                labels.update(payload[key])
        for label, value, addrs in self.routes:
            if str(labels.get(label, "")) == value:
                return addrs
        return self.to

    def _heartbeat_payload(self, status, seconds):
        if status == "firing":
            summary = (f"No {self.heartbeat_alert} heartbeat for {seconds}s. "
                       "The alerting pipeline (Prometheus, Alertmanager, or "
                       "the network to this host) may be down, so other "
                       "alerts may not be arriving.")
        else:
            summary = (f"The {self.heartbeat_alert} heartbeat is back after "
                       f"{seconds}s of silence.")
        return {"groupKey": f"lane-mail-alert/heartbeat/{self.heartbeat_alert}",
                "status": status, "receiver": "lane-mail-alert heartbeat",
                "groupLabels": {"alertname": "AlertingQuiet"},
                "alerts": [{"status": status, "fingerprint": "heartbeat",
                            "labels": {"alertname": "AlertingQuiet",
                                       "heartbeat": self.heartbeat_alert},
                            "annotations": {"summary": summary}}]}

    def check_heartbeat(self):
        """Mails AlertingQuiet when the heartbeat has been silent too long."""
        with self.hb_lock:
            silent = int(time.time() - self.hb_last)
            if self.hb_quiet or silent < self.heartbeat:
                return None
        result = self.handle(self._heartbeat_payload("firing", silent))
        with self.hb_lock:
            self.hb_quiet = True
        return result

    def _take_heartbeat(self, payload):
        """Strips heartbeat alerts from a payload; returns what is left."""
        alerts = payload.get("alerts")
        if not self.heartbeat or not isinstance(alerts, list):
            return payload, None
        beats = [a for a in alerts if isinstance(a, dict) and
                 (a.get("labels") or {}).get("alertname") ==
                 self.heartbeat_alert]
        if not beats:
            return payload, None
        with self.hb_lock:
            gap = int(time.time() - self.hb_last)
            back = self.hb_quiet
            self.hb_last = time.time()
            self.hb_quiet = False
        resolved = None
        if back:
            resolved = self.handle(self._heartbeat_payload("resolved", gap))
        rest = [a for a in alerts if a not in beats]
        return (dict(payload, alerts=rest) if rest else None), resolved

    def handle_webhook(self, payload):
        if isinstance(payload, dict):
            payload, resolved = self._take_heartbeat(payload)
            if payload is None:
                out = {"result": "heartbeat", "group": None, "id": None,
                       "thread": None}
                if resolved:
                    out["resolved"] = resolved
                return out
        return self.handle(payload)

    def _state_path(self, group):
        return self.state_dir / f"{group}.json"

    def _load(self, group):
        try:
            st = json.loads(self._state_path(group).read_text())
        except (OSError, ValueError):
            return None
        return st if isinstance(st, dict) else None

    def _save(self, group, st):
        path = self._state_path(group)
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(st, sort_keys=True) + "\n")
        os.replace(tmp, path)

    def handle(self, payload):
        group, status, alerts = parse(payload)
        firing = sorted(alert_fingerprint(a) for a in alerts
                        if a.get("status", "firing") == "firing")
        self.state_dir.mkdir(parents=True, exist_ok=True)
        with open(self.state_dir / ".lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            return self._handle_locked(payload, group, status, alerts, firing)

    def _handle_locked(self, payload, group, status, alerts, firing):
        st = self._load(group)
        now = int(time.time())
        if st and st.get("status") == status and st.get("firing") == firing:
            return {"result": "duplicate", "group": group,
                    "id": st.get("last"), "thread": st.get("thread")}

        subject = subject_for(payload, status, alerts)
        body = body_for(payload, group, status, alerts)
        common = ["--from", self.sender, "--to", self.recipients(payload),
                  "--subject", subject,
                  "--header", f"X-Alert-Group: {group}",
                  "--header", f"X-Alert-Status: {status}",
                  "--body", "-"]
        continues = st and st.get("last") and (
            st.get("status") == "firing" or
            (status == "firing" and self.reopen > 0 and
             now - int(st.get("updated", 0)) < self.reopen))
        result = None
        if continues:
            try:
                mid = run_mail(self.cmd,
                               ["reply", "--reply-to", st["last"], *common],
                               body)
                result = {"result": "replied", "id": mid,
                          "thread": st.get("thread", mid)}
            except SendFailed as e:
                # The thread may be gone from the store; a new thread still
                # tells the lane. A failure that is not about the thread
                # fails the send below too, and is reported from there.
                print(f"lane-mail-alert: group {group}: reply failed "
                      f"({e}); opening a new thread", file=sys.stderr)
        if result is None:
            mid = run_mail(self.cmd, ["send", *common], body)
            result = {"result": "sent", "id": mid, "thread": mid}
        self._save(group, {"thread": result["thread"], "last": result["id"],
                           "status": status, "firing": firing,
                           "updated": now})
        result["group"] = group
        return result


def make_handler(bridge, token):
    class Handler(BaseHTTPRequestHandler):
        server_version = "lane-mail-alert"

        def _reply(self, code, obj):
            data = (json.dumps(obj) + "\n").encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def log_message(self, fmt, *args):
            print(f"lane-mail-alert: {self.address_string()} {fmt % args}",
                  file=sys.stderr)

        def do_GET(self):
            if self.path == "/healthz":
                data = b"ok\n"
                self.send_response(200)
                self.send_header("Content-Type", "text/plain")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
            else:
                self._reply(404, {"error": "not found"})

        def do_POST(self):
            if self.path != "/v1/alert":
                self._reply(404, {"error": "not found"})
                return
            auth = self.headers.get("Authorization", "")
            if not hmac.compare_digest(auth.encode(),
                                       f"Bearer {token}".encode()):
                self._reply(401, {"error": "missing or wrong bearer token"})
                return
            try:
                length = int(self.headers.get("Content-Length", ""))
            except ValueError:
                self._reply(411, {"error": "Content-Length required"})
                return
            if length < 0 or length > MAX_BODY:
                self._reply(413, {"error": "body over 1 MiB"})
                return
            raw = self.rfile.read(length)
            try:
                result = bridge.handle_webhook(json.loads(raw))
            except (ValueError, BadPayload) as e:
                self._reply(400, {"error": oneline(e)})
                return
            except SendFailed as e:
                print(f"lane-mail-alert: send failed: {e}", file=sys.stderr)
                self._reply(500, {"error": f"lane-mail: {e}"})
                return
            if result["result"] != "heartbeat":
                print(f"lane-mail-alert: group {result['group']}: "
                      f"{result['result']} {result['id']}", file=sys.stderr)
            self._reply(200, result)

    return Handler


def die(msg, code=2):
    print(f"lane-mail-alert: {msg}", file=sys.stderr)
    sys.exit(code)


def read_token(path):
    try:
        token = Path(path).read_text().strip()
    except OSError as e:
        die(f"cannot read --token-file: {e}")
    if len(token) < 16 or any(c.isspace() for c in token):
        die("the token must be at least 16 characters "
                 "with no whitespace")
    return token


def main():
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("mode", nargs="?")
    p.add_argument("-h", "--help", action="store_true")
    p.add_argument("--to", default="@ops")
    p.add_argument("--from", dest="sender", default="@alerts")
    p.add_argument("--state-dir", default=default_state_dir())
    p.add_argument("--reopen", type=int, default=3600)
    p.add_argument("--listen")
    p.add_argument("--token-file")
    p.add_argument("--via", default="lane")
    p.add_argument("--route", action="append", default=[])
    p.add_argument("--heartbeat", type=int, default=0)
    p.add_argument("--heartbeat-alert", default="Watchdog")
    try:
        a = p.parse_args()
    except SystemExit:
        sys.exit(2)
    if a.help or not a.mode:
        print(__doc__.strip())
        sys.exit(0)

    if a.via not in VIA:
        die(f"bad --via '{a.via}' (lane, fleet, remote)")
    addr_re = ADDR_RE if a.via == "lane" else LOCAL_ADDR_RE

    def addr_list(value, what):
        addrs = [t.strip() for t in value.split(",")]
        if not all(addr_re.match(t) for t in addrs):
            die(f"bad {what} '{value}' (comma-separated addresses: @name"
                + (", or @lane:host" if a.via == "lane" else "") + ")")
        return ",".join(addrs)

    to = addr_list(a.to, "--to")
    routes = []
    for spec in a.route:
        route = parse_route(spec)
        if route is None:
            die(f"bad --route '{spec}' (LABEL=VALUE:@name[,@name])")
        routes.append((route[0], route[1], addr_list(route[2], "--route")))
    if a.heartbeat < 0:
        die("--heartbeat must be >= 0")
    if a.heartbeat and a.mode != "serve":
        die("--heartbeat needs serve: it watches for a heartbeat over time")
    if not LOCAL_ADDR_RE.match(a.sender):
        die(f"bad --from '{a.sender}' (a lane on this "
                 "host: @lane)")
    if a.reopen < 0:
        die("--reopen must be >= 0")
    bridge = Bridge(to, a.sender, a.state_dir, a.reopen, a.via, routes,
                    a.heartbeat, a.heartbeat_alert)

    if a.mode == "ingest":
        try:
            result = bridge.handle_webhook(json.loads(sys.stdin.read()))
        except (ValueError, BadPayload) as e:
            print(f"lane-mail-alert: bad payload: {oneline(e)}",
                  file=sys.stderr)
            sys.exit(2)
        except SendFailed as e:
            print(f"lane-mail-alert: send failed: {e}", file=sys.stderr)
            sys.exit(1)
        print(json.dumps(result))
        return
    if a.mode != "serve":
        die(f"unknown mode '{a.mode}' (serve, ingest)")
    if not a.listen or not a.token_file:
        die("serve needs --listen HOST:PORT and "
                 "--token-file FILE")
    host, _, port = a.listen.rpartition(":")
    if not host or not port.isdigit():
        die(f"bad --listen '{a.listen}' (HOST:PORT)")
    token = read_token(a.token_file)
    server = HTTPServer((host, int(port)),
                        make_handler(bridge, token))
    print(f"lane-mail-alert: listening on {host}:{server.server_address[1]}, "
          f"mailing {bridge.to} "
          f"as {bridge.sender}", file=sys.stderr)
    if a.heartbeat:
        threading.Thread(target=heartbeat_loop, args=(bridge,),
                         daemon=True).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


def heartbeat_loop(bridge):
    tick = min(max(bridge.heartbeat / 4, 0.25), 30)
    while True:
        time.sleep(tick)
        try:
            result = bridge.check_heartbeat()
        except SendFailed as e:
            print(f"lane-mail-alert: heartbeat alert failed, will retry: {e}",
                  file=sys.stderr)
            continue
        if result:
            print(f"lane-mail-alert: heartbeat quiet: {result['result']} "
                  f"{result['id']}", file=sys.stderr)


if __name__ == "__main__":
    main()
