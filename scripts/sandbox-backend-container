#!/usr/bin/env bash
# sandbox-backend-container — the container implementation of the sandbox backend contract
#
# Usage: sandbox-backend-container --workdir DIR --net pinned|sealed|unpinned
#          --image NAME [--bind-ro PATH]... [--bind-rw PATH]...
#          [--bind-ro-at SRC DEST]... [--bind-rw-at SRC DEST]...
#          [--bridge SOCKET=PORT]... [--setenv K=V]... [--prepend-path DIR]...
#          [--hostname NAME] -- COMMAND [ARG...]
#
# --image selects the Linux image; FORK_SANDBOX_CONTAINER_IMAGE is its
# default. The runtime is docker unless FORK_SANDBOX_CONTAINER_CLI overrides
# it. Only Docker is tested; Podman's rootless uid remapping is untested.
# --workdir and --bind-rw paths persist on the host; --bind-ro paths are
# readable only. Remapped forms mount SRC at absolute DEST. --setenv passes
# exactly NAME=VALUE (never host-inheriting bare --env NAME). Later
# --prepend-path flags appear earlier. --hostname sets the container hostname.
# --net has no default: sealed has loopback only; pinned reaches public
# internet and the LAN but blackholes host, tunnel and bridge destinations;
# unpinned is an extension with unrestricted bridge egress and a warning.
# --bridge SOCKET=PORT works only sealed and relays a read-only-mounted host
# unix socket to container loopback. A bridge proves that a listener exists
# on the port, not that the endpoint behind it is alive: the readiness probe
# is a TCP connect, which the relay satisfies as soon as it binds, whether or
# not its target unix socket has anything listening. A dead peer surfaces
# only on the first real connection attempt, not at startup. -- ends options;
# the remaining argv and its authoritative `docker wait` exit status are the
# command and backend status.
#
# The image supplies the sandbox toolchain, unlike bwrap, which mounts host
# /usr. It must contain bash; pinned mode also needs iproute2's ip, and bridges
# need socat. A host toolchain bind works on Linux only if ABI-compatible and
# cannot work with macOS Mach-O binaries. On macOS the image must carry it.
# A synthesized passwd/group replaces the image files for a non-root host uid;
# images whose entrypoint depends on their own users are unsupported. This
# backend overrides the entrypoint.
#
# What the sandbox gets: a disposable writable image overlay, empty tmpfs /tmp
# and $HOME, only named host mounts, host uid/gid, dropped capabilities,
# no-new-privileges, Docker's default seccomp, init, a minimal explicit
# environment, and stdin unchanged. The overlay is not a host-persistent write.
#
# Limits:
#   - Isolation strength: shared-kernel namespaces on Linux, so a kernel bug is
#     an escape. On macOS it escapes into the runtime's Linux VM, not directly
#     into the Mac. A rootful Docker daemon is root-equivalent; writable-path
#     refusals guard operator mistakes, not the daemon boundary.
#   - Syscall filtering: Docker's default seccomp profile applies (stronger
#     than bwrap's none), but blocks nested user namespaces. Chromium and
#     Playwright need --no-sandbox and nested bwrap cannot work. Runtime option
#     seccomp=unconfined is an escape hatch that gives up this protection; this
#     backend does not select it.
#   - LAN reachability: pinned LAN traffic is NATed from the host, so a service
#     trusting network position cannot distinguish it. The pin is a destination
#     denylist snapshot, not a source-interface pin: later tunnels are covered
#     only by fixed private ranges, and global tunnel prefixes only if present
#     at startup. Docker DNS may resolve VPN-only names via the daemon even
#     though their addresses are unreachable: names leak, reachability does not.
#   - Resource limits: none. Docker supports --memory, --cpus and --pids-limit,
#     but this backend does not set them.
#   - SIGKILL leaves the stopped labeled container, labeled network, and state
#     dir; the kernel releases the lock. Find strays with `docker ps -a
#     --filter label=fork-sandbox-run` and `docker network ls --filter
#     label=fork-sandbox-run`.
#   - --bridge is verified only on Linux and probably fails through Docker
#     Desktop/Colima filesystem sharing. Treat it as Linux-only until verified.
#   - macOS needs `flock` on PATH (stock macOS ships neither it nor GNU
#     md5sum); this script refuses up front rather than failing confusingly
#     on either. The Darwin routing branch itself remains unverified.

set -euo pipefail

script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=fork-sandbox-lib.sh
# shellcheck disable=SC1091
source "$script_dir/fork-sandbox-lib.sh"

if [[ "${1-}" == -h || "${1-}" == --help ]]; then
    sed -n '2,/^$/p' "$(readlink -f "${BASH_SOURCE[0]}")" | sed 's/^# \{0,1\}//'
    exit 0
fi

CLI="${FORK_SANDBOX_CONTAINER_CLI:-docker}"
IMAGE="${FORK_SANDBOX_CONTAINER_IMAGE:-}"
WORK_DIR_ARG=""; NET_MODE=""; HOSTNAME_ARG=""
BIND_RO=(); BIND_RW=(); BIND_RO_AT_SRC=(); BIND_RO_AT_DEST=()
BIND_RW_AT_SRC=(); BIND_RW_AT_DEST=(); BRIDGE_SOCKETS=(); BRIDGE_PORTS=()
SETENV=(); PREPEND_PATH=()
while (( $# )); do
    case "$1" in
        --workdir) WORK_DIR_ARG="${2:?--workdir requires a directory}"; shift 2 ;;
        --net) NET_MODE="${2:?--net requires pinned, sealed or unpinned}"; shift 2 ;;
        --image) IMAGE="${2:?--image requires a name}"; shift 2 ;;
        --hostname) HOSTNAME_ARG="${2:?--hostname requires a name}"; shift 2 ;;
        --bind-ro) BIND_RO+=("${2:?--bind-ro requires a path}"); shift 2 ;;
        --bind-rw) BIND_RW+=("${2:?--bind-rw requires a path}"); shift 2 ;;
        --bind-ro-at) BIND_RO_AT_SRC+=("${2:?--bind-ro-at requires a source path}"); BIND_RO_AT_DEST+=("${3:?--bind-ro-at requires a destination path}"); shift 3 ;;
        --bind-rw-at) BIND_RW_AT_SRC+=("${2:?--bind-rw-at requires a source path}"); BIND_RW_AT_DEST+=("${3:?--bind-rw-at requires a destination path}"); shift 3 ;;
        --bridge)
            v="${2:?--bridge requires SOCKET=PORT}"
            if [[ "$v" != *=* ]]; then echo "Error: --bridge '$v' has no port. The form is" >&2; echo "SOCKET=PORT." >&2; exit 1; fi
            BRIDGE_SOCKETS+=("${v%=*}"); BRIDGE_PORTS+=("${v##*=}"); shift 2 ;;
        --setenv) SETENV+=("${2:?--setenv requires NAME=VALUE}"); shift 2 ;;
        --prepend-path) PREPEND_PATH+=("${2:?--prepend-path requires a directory}"); shift 2 ;;
        --) shift; break ;;
        *) echo "Error: unknown option '$1'. The command goes after '--'." >&2; exit 1 ;;
    esac
done
(( $# )) || { echo "Error: no command. Everything after '--' is the command to run." >&2; exit 1; }
[[ -n "$WORK_DIR_ARG" ]] || { echo "Error: --workdir is required. It is the one writable project directory." >&2; exit 1; }
case "$NET_MODE" in pinned|sealed|unpinned) ;; "") echo "Error: --net is required, and has no default." >&2; exit 1 ;; *) echo "Error: --net '$NET_MODE' is not a mode. Use pinned, sealed or unpinned." >&2; exit 1 ;; esac
[[ -n "$IMAGE" ]] || { echo "Error: --image is required (or set FORK_SANDBOX_CONTAINER_IMAGE)." >&2; exit 1; }

is_refused_work_dir() {
    local d="$1" p
    case "$d" in /|"$HOME"|/home|/root|/boot|/var|/var/tmp|/var/tmp/claude-scratch|/var/tmp/claude-scratch/forks|/tmp|/opt|/srv|/mnt|/nix) return 0 ;; esac
    for p in /usr /etc /bin /sbin /lib /lib64 /proc /sys /dev /run /boot; do [[ "$d" == "$p" || "$d" == "$p"/* ]] && return 0; done
    return 1
}
check_remap_dest() {
    local flag="$1" dest="$2"
    [[ "$dest" == /* ]] || { echo "Error: $flag destination '$dest' must be absolute." >&2; return 1; }
    [[ "$dest/" != *"/../"* ]] || { echo "Error: $flag destination '$dest' must not contain a '..' component." >&2; return 1; }
}
check_mount_path() {
    local flag="$1" path="$2"
    [[ "$path" != *,* ]] || { echo "Error: $flag path '$path' contains a comma, which the container runtime's --mount syntax cannot represent." >&2; return 1; }
}
is_tunnel_iface() { case "$1" in tailscale*|ts*|wg*|tun*|tap*|zt*|ppp*|nebula*|gpd*) return 0 ;; *) return 1 ;; esac; }

# Docker can answer a gateway/subnet lookup with a non-empty but bogus value
# instead of failing outright — a created-but-not-started container reports
# its gateway as the literal string "invalid IP" — so callers validate the
# SHAPE of what comes back rather than trust mere non-emptiness before it is
# interpolated into a generated `ip route` command.
is_valid_ipv4() {
    local ip="$1" octets o
    [[ "$ip" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || return 1
    IFS=. read -ra octets <<<"$ip"
    for o in "${octets[@]}"; do (( 10#$o <= 255 )) || return 1; done
    return 0
}
is_valid_ipv4_cidr() {
    local cidr="$1"
    [[ "$cidr" == */* ]] || return 1
    is_valid_ipv4 "${cidr%/*}" || return 1
    [[ "${cidr#*/}" =~ ^[0-9]{1,2}$ ]] && (( 10#${cidr#*/} <= 32 ))
}
# The lock file name only needs a stable digest of the work dir, not a
# cryptographic one, so any of these does: GNU md5sum (Linux), BSD md5 -q
# (stock macOS), or cksum (POSIX, everywhere) as a last resort.
digest() {
    if command -v md5sum >/dev/null 2>&1; then md5sum | cut -d' ' -f1
    elif command -v md5 >/dev/null 2>&1; then md5 -q
    else cksum | cut -d' ' -f1
    fi
}

mkdir -p /var/tmp/claude-scratch/forks "$WORK_DIR_ARG"
WORK_DIR="$(realpath "$WORK_DIR_ARG")"
is_refused_work_dir "$WORK_DIR" && { echo "Error: refusing '$WORK_DIR' as the work dir. It is bind-mounted writable." >&2; exit 1; }
check_mount_path --workdir "$WORK_DIR" || exit 1

MOUNTS=(--mount "type=bind,src=$WORK_DIR,dst=$WORK_DIR")
for d in "${BIND_RO[@]}"; do [[ -e "$d" ]] || { echo "Error: --bind-ro '$d' does not exist." >&2; exit 1; }; s="$(realpath "$d")"; r="$(realpath -s "$d")"; check_mount_path --bind-ro "$s" && check_mount_path --bind-ro "$r" || exit 1; MOUNTS+=(--mount "type=bind,src=$s,dst=$r,readonly"); done
for d in "${BIND_RW[@]}"; do
    [[ -e "$d" ]] || { echo "Error: --bind-rw '$d' does not exist." >&2; exit 1; }; r="$(realpath "$d")"
    is_refused_work_dir "$r" && { echo "Error: refusing '$r' as a --bind-rw path. It would be writable inside the sandbox." >&2; exit 1; }
    s="$(realpath -s "$d")"; check_mount_path --bind-rw "$r" && check_mount_path --bind-rw "$s" || exit 1
    MOUNTS+=(--mount "type=bind,src=$r,dst=$s")
done
for i in "${!BIND_RO_AT_SRC[@]}"; do s="${BIND_RO_AT_SRC[$i]}"; d="${BIND_RO_AT_DEST[$i]}"; [[ -e "$s" ]] || { echo "Error: --bind-ro-at source '$s' does not exist." >&2; exit 1; }; check_remap_dest --bind-ro-at "$d" || exit 1; s="$(realpath "$s")"; check_mount_path --bind-ro-at "$s" && check_mount_path --bind-ro-at "$d" || exit 1; MOUNTS+=(--mount "type=bind,src=$s,dst=$d,readonly"); done
for i in "${!BIND_RW_AT_SRC[@]}"; do s="${BIND_RW_AT_SRC[$i]}"; d="${BIND_RW_AT_DEST[$i]}"; [[ -e "$s" ]] || { echo "Error: --bind-rw-at source '$s' does not exist." >&2; exit 1; }; check_remap_dest --bind-rw-at "$d" || exit 1; r="$(realpath "$s")"; is_refused_work_dir "$r" && { echo "Error: refusing '$r' as a --bind-rw-at source." >&2; exit 1; }; check_mount_path --bind-rw-at "$r" && check_mount_path --bind-rw-at "$d" || exit 1; MOUNTS+=(--mount "type=bind,src=$r,dst=$d"); done

SETENV_NAMES=()
for kv in "${SETENV[@]}"; do [[ "$kv" == *=* ]] || { echo "Error: --setenv '$kv' is not NAME=VALUE." >&2; exit 1; }; [[ "${kv%%=*}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "Error: --setenv names a variable that is not [A-Za-z_][A-Za-z0-9_]*: '${kv%%=*}'" >&2; exit 1; }; SETENV_NAMES+=("${kv%%=*}"); done
if (( ${#BRIDGE_SOCKETS[@]} )) && [[ "$NET_MODE" != sealed ]]; then echo "Error: --bridge works only with --net sealed." >&2; exit 1; fi
for i in "${!BRIDGE_SOCKETS[@]}"; do
    s="${BRIDGE_SOCKETS[$i]}"; p="${BRIDGE_PORTS[$i]}"
    [[ -S "$s" ]] || { echo "Error: --bridge source '$s' is not a unix socket." >&2; exit 1; }
    if [[ ! "$p" =~ ^[1-9][0-9]{0,4}$ ]] || (( p > 65535 )); then
        echo "Error: --bridge '$s=$p' has a port that is not a number from 1 to 65535." >&2
        exit 1
    fi
    (( p >= 1024 )) || { echo "Error: --bridge '$s=$p' would listen on a privileged port. Use 1024 or higher." >&2; exit 1; }
    for j in "${!BRIDGE_PORTS[@]}"; do (( j < i )) || continue; [[ "${BRIDGE_PORTS[$j]}" != "$p" ]] || { echo "Error: two --bridge flags want in-sandbox port $p." >&2; exit 1; }; done
    fs_reject_unsafe_chars "$s" "$p" || exit 1
    check_mount_path --bridge "$(dirname "$(realpath "$s")")" || exit 1
done

SANDBOX_PATH="$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
for d in "${PREPEND_PATH[@]}"; do [[ -d "$d" ]] || { echo "Error: --prepend-path '$d' is not a directory on the host." >&2; exit 1; }; SANDBOX_PATH="$d:$SANDBOX_PATH"; done
COMMAND_ENV=("HOME=$HOME" "PATH=$SANDBOX_PATH" "TERM=${TERM:-dumb}" "LANG=${LANG:-C.UTF-8}" "USER=${USER:-sandbox}" "SHELL=/bin/bash" "PYTHONDONTWRITEBYTECODE=1")
COMMAND_ENV+=("${SETENV[@]}")
command -v "$CLI" >/dev/null || { echo "Error: container runtime '$CLI' not found." >&2; exit 1; }
if ! "$CLI" run --rm --entrypoint /bin/sh "$IMAGE" -c 'command -v bash >/dev/null'; then
    echo "Error: image '$IMAGE' does not provide bash." >&2; exit 1
fi
# BusyBox (present on every Alpine image) ships its own `ip` applet, so
# `command -v ip` succeeds even with no iproute2 installed at all — the probe
# has to test capability, not mere presence. BusyBox's `ip -V` also exits 0,
# so the exit status alone cannot tell them apart either; only grepping the
# version string for "iproute2" does.
if [[ "$NET_MODE" == pinned ]] && ! "$CLI" run --rm --entrypoint /bin/sh "$IMAGE" -c 'ip -V 2>&1 | grep -q iproute2'; then
    echo "Error: image '$IMAGE' does not provide iproute2's ip (BusyBox's ip applet is not enough for pinned mode); install iproute2." >&2; exit 1
fi
if (( ${#BRIDGE_SOCKETS[@]} )) && ! "$CLI" run --rm --entrypoint /bin/sh "$IMAGE" -c 'command -v socat >/dev/null'; then
    echo "Error: image '$IMAGE' does not provide socat, required by --bridge." >&2; exit 1
fi

# flock(1) is util-linux, absent on stock macOS. A mkdir-based substitute
# would lose the property flock gives for free: the kernel releases it
# however the holding process dies, including SIGKILL, so a stale lock never
# outlives its process. Refuse outright rather than fake the lock or silently
# skip it.
command -v flock >/dev/null 2>&1 || {
    echo "Error: flock not found. This backend serializes runs against the" >&2
    echo "same --workdir with it, and there is no substitute that keeps its" >&2
    echo "release-on-SIGKILL property. On macOS: brew install util-linux," >&2
    echo "then add its (keg-only) bin directory to PATH." >&2
    exit 1
}
LOCK_FILE="/var/tmp/claude-scratch/forks/.sandbox-backend-lock-$(printf '%s' "$WORK_DIR" | digest)"
exec 9>"$LOCK_FILE"; flock -n 9 || { echo "Error: another sandbox is already using $WORK_DIR" >&2; exit 1; }
RUN_ID="$(date +%s)-$$-$RANDOM"; STATE_DIR="$(mktemp -d /var/tmp/claude-scratch/forks/sandbox-backend-container.XXXXXX)"
CONTAINER=""; NETWORK=""
# shellcheck disable=SC2329  # invoked by the EXIT trap
cleanup() { set +e; [[ -z "$CONTAINER" ]] || "$CLI" rm -f "$CONTAINER" >/dev/null 2>&1; [[ -z "$NETWORK" ]] || "$CLI" network rm "$NETWORK" >/dev/null 2>&1; rm -rf "$STATE_DIR"; }
trap cleanup EXIT

uid_n="$(id -u)"; gid_n="$(id -g)"
if (( uid_n != 0 )); then
    printf 'root:x:0:0:root:/root:/bin/bash\nsandbox:x:%s:%s:sandbox:%s:/bin/bash\nnobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin\n' "$uid_n" "$gid_n" "$HOME" >"$STATE_DIR/passwd"
    printf 'root:x:0:\nsandbox:x:%s:\nnogroup:x:65534:\n' "$gid_n" >"$STATE_DIR/group"
    MOUNTS+=(--mount "type=bind,src=$STATE_DIR/passwd,dst=/etc/passwd,readonly" --mount "type=bind,src=$STATE_DIR/group,dst=/etc/group,readonly")
fi

bridge_dirs=()
for s in "${BRIDGE_SOCKETS[@]}"; do d="$(dirname "$(realpath "$s")")"; seen=0; for r in "${bridge_dirs[@]}"; do [[ "$r" == "$d" ]] && seen=1; done; (( seen )) || { bridge_dirs+=("$d"); MOUNTS+=(--mount "type=bind,src=$d,dst=$d,readonly"); }; done

# Generated INSIDE the container and run before the caller's command. In
# pinned mode it polls for the sentinel blackhole 169.254.0.0/16 — deliberately
# installed last by the pin helper below, after every other route, so its
# appearance means the whole program ran, not just some prefix of it — and
# refuses to run the command if it never shows up within the timeout. That
# makes the sandbox verify its own pin rather than trust that the helper ran:
# a helper that failed, or was skipped, fails the whole run closed instead of
# silently running unpinned.
# For each --bridge it starts the relay and a watchdog that names the socket
# if it later vanishes, then waits for the relay's port to accept a TCP
# connection before continuing — see the --bridge paragraph above for what
# that readiness check does and does not prove.
{
    echo '#!/usr/bin/env bash'; echo 'set -euo pipefail'
    if [[ "$NET_MODE" == pinned ]]; then echo 'for ((i=0;i<200;i++)); do ip route show type blackhole | grep -q "169.254.0.0/16" && break; sleep .05; done'; echo 'ip route show type blackhole | grep -q "169.254.0.0/16" || { echo "Error: pinned-egress route gate timed out; command not run." >&2; exit 1; }'; fi
    for i in "${!BRIDGE_SOCKETS[@]}"; do printf 'socat %q %q &\n' "TCP-LISTEN:${BRIDGE_PORTS[$i]},bind=127.0.0.1,reuseaddr,fork" "UNIX-CONNECT:${BRIDGE_SOCKETS[$i]}"; printf '(while [[ -S %q ]]; do sleep 1; done; kill -TERM $$) &\n' "${BRIDGE_SOCKETS[$i]}"; done
    for p in "${BRIDGE_PORTS[@]}"; do printf 'ready=0; for ((i=0;i<100;i++)); do (exec 3<>/dev/tcp/127.0.0.1/%q) 2>/dev/null && { ready=1; break; }; sleep .02; done; (( ready )) || { echo "Error: bridge listener on port %q did not become ready; command not run." >&2; exit 1; }\n' "$p" "$p"; done
    printf 'exec env -i'; for kv in "${COMMAND_ENV[@]}"; do printf ' %q' "$kv"; done; echo ' "$@"'
} >"$STATE_DIR/bootstrap"; chmod +x "$STATE_DIR/bootstrap"
MOUNTS+=(--mount "type=bind,src=$STATE_DIR/bootstrap,dst=/fork-sandbox-bootstrap,readonly")

NET_ARGS=()
if [[ "$NET_MODE" == sealed ]]; then NET_ARGS=(--network none); else NETWORK="fork-sandbox-$RUN_ID"; "$CLI" network create --label "fork-sandbox-run=$RUN_ID" "$NETWORK" >/dev/null; NET_ARGS=(--network "$NETWORK"); fi
[[ "$NET_MODE" != unpinned ]] || echo "sandbox-backend-container: egress not pinned: tunnels, VPNs and bridge networks reachable" >&2

ENV_ARGS=()
for kv in "${COMMAND_ENV[@]}"; do ENV_ARGS+=(--env "$kv"); done
TTY=(); [[ -t 0 && -t 1 ]] && TTY=(-t)
# Docker's --tmpfs default options include noexec, which bwrap's equivalent
# scratch does not apply — a silent divergence from the reference backend
# that breaks a helper script written to /tmp and run, or a `pip install
# --user`/`npm i -g` into a $HOME prefix, with a bare "Permission denied"
# that points nowhere near the mount. Pass the rest of Docker's default set
# explicitly, restoring only exec, for parity with bwrap.
CREATE_ARGS=(create --label "fork-sandbox-run=$RUN_ID" --init --user "$uid_n:$gid_n" --cap-drop=ALL --security-opt no-new-privileges --tmpfs "/tmp:rw,nosuid,nodev,exec" --tmpfs "$HOME:rw,nosuid,nodev,exec" -i "${TTY[@]}" "${NET_ARGS[@]}" "${MOUNTS[@]}" "${ENV_ARGS[@]}" --workdir "$WORK_DIR" --entrypoint /bin/bash)
[[ -z "$HOSTNAME_ARG" ]] || CREATE_ARGS+=(--hostname "$HOSTNAME_ARG")
CONTAINER="$("$CLI" "${CREATE_ARGS[@]}" "$IMAGE" /fork-sandbox-bootstrap "$@")" || { echo "Error: container create failed; command did not start." >&2; exit 1; }

if [[ "$NET_MODE" == pinned ]]; then
    host_os="$(uname -s)"; [[ "$host_os" != Darwin ]] || echo "Warning: pinned routing on Darwin is unverified." >&2
    # The gateway and subnet are read from the NETWORK, not the container:
    # IPAM config is populated when the network is created, before any
    # container joins it, so both are available here regardless of container
    # state — no reordering needed. Reading the gateway off the container
    # instead would race container start, and Docker does not fail closed on
    # that race: a created-but-not-started container reports its gateway as
    # the literal string "invalid IP", which is non-empty and would sail
    # through an emptiness check straight into the generated `ip route`
    # command below. Both values are validated for shape, not just presence.
    if [[ "$host_os" == Linux ]]; then
        default_line="$(ip -4 route show default | head -n1)" || true; iface="$(awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' <<<"$default_line")"
        [[ -n "$iface" ]] || { echo "Error: cannot determine default-route interface; refusing unpinned run." >&2; exit 1; }
        is_tunnel_iface "$iface" && { echo "Error: default route interface '$iface' is a tunnel; refusing unpinned run." >&2; exit 1; }
        gateway="$("$CLI" network inspect -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}' "$NETWORK")"
        container_subnet="$("$CLI" network inspect -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}' "$NETWORK")"
        if ! is_valid_ipv4 "$gateway" || ! is_valid_ipv4_cidr "$container_subnet"; then echo "Error: container network gateway '$gateway' or subnet '$container_subnet' is not a valid address; refusing pinned run." >&2; exit 1; fi
        # Five fixed private/special-use ranges denied outright, then every
        # host prefix reachable through a NON-default interface (other
        # tunnels, other bridges), then every address the default interface
        # itself holds, then the gateway's own /32 (kept usable only as a
        # route next-hop below, never as a destination), then the LAN
        # prefixes on the default interface restored as normal routes so the
        # local network stays reachable, and only THEN the 169.254.0.0/16
        # sentinel blackhole the generated bootstrap gates on (see its
        # comment above). Which destination each route denies does not
        # depend on installation order: the kernel selects routes by
        # longest-prefix match, so a /32 always outranks the broader
        # blackhole it sits inside, and a restored LAN /24 always outranks
        # the /8-/12-/16 denials, regardless of which rule went in first.
        # But the GATE cares about order: it is watching for one specific
        # route, so that route has to be the last one this program installs,
        # or the gate can fire while routes after it are still pending.
        # `bash -c` reports only the exit status of the LAST command in a
        # `;`-separated string, so without `set -e` a route failing partway
        # through would be invisible: the helper would still exit 0 and the
        # gate would still see the sentinel, ending up pinned less than it
        # thinks. With `set -e`, a failure aborts the helper before the
        # sentinel is reached, so it never appears and the gate times out
        # instead — fail-closed, not silently short.
        routes='set -e; ip route add blackhole 10.0.0.0/8; ip route add blackhole 172.16.0.0/12; ip route add blackhole 192.168.0.0/16; ip route add blackhole 100.64.0.0/10; ip route add blackhole 198.18.0.0/15; ip -6 route add blackhole default'
        while read -r prefix dev; do [[ -n "$prefix" && "$prefix" != "$container_subnet" && "$dev" != "$iface" ]] && routes+="; ip route replace blackhole $prefix"; done < <(ip -4 route show | awk '$1 != "default" {p=$1; for(i=1;i<=NF;i++) if($i=="dev") {print p, $(i+1); break}}')
        while read -r addr; do routes+="; ip route replace blackhole $addr/32"; done < <(ip -4 -o addr show dev "$iface" scope global | awk '{split($4,a,"/"); print a[1]}')
        routes+="; ip route replace blackhole $gateway/32"
        while read -r prefix; do routes+="; ip route replace $prefix via $gateway"; done < <(ip -4 route show dev "$iface" scope link | awk '$1 != "default" {print $1}')
        routes+="; ip route add blackhole 169.254.0.0/16"
    elif [[ "$host_os" == Darwin ]]; then
        default_line="$(route -n get default)" || true; iface="$(awk '/interface:/{print $2}' <<<"$default_line")"; [[ -n "$iface" ]] || { echo "Error: Darwin default route parse failed; refusing unpinned run." >&2; exit 1; }
        is_tunnel_iface "$iface" && { echo "Error: default route interface '$iface' is a tunnel." >&2; exit 1; }
        gateway="$("$CLI" network inspect -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}' "$NETWORK")"; container_subnet="$("$CLI" network inspect -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}' "$NETWORK")"; if ! is_valid_ipv4 "$gateway" || ! is_valid_ipv4_cidr "$container_subnet"; then echo "Error: container network gateway '$gateway' or subnet '$container_subnet' is not a valid address; refusing pinned run." >&2; exit 1; fi
        # See the matching Linux branch above for why 169.254.0.0/16 is
        # appended last rather than joining the other fixed ranges here, and
        # for why the program is prefixed with `set -e`: without it, `bash
        # -c` reports only the last command's status, so a route failing
        # partway through would be invisible; with it, that failure aborts
        # the helper before the sentinel is installed, so the gate times out
        # instead of running the command on a partial pin.
        routes='set -e; ip route add blackhole 10.0.0.0/8; ip route add blackhole 172.16.0.0/12; ip route add blackhole 192.168.0.0/16; ip route add blackhole 100.64.0.0/10; ip route add blackhole 198.18.0.0/15; ip -6 route add blackhole default'; while read -r prefix dev; do [[ "$prefix" == "$container_subnet" || "$dev" == "$iface" ]] || routes+="; ip route replace blackhole $prefix"; done < <(netstat -rn -f inet | awk 'NR>4 && $1 != "default" && $1 ~ /\// {print $1, $NF}'); while read -r addr; do routes+="; ip route replace blackhole $addr/32"; done < <(ifconfig "$iface" | awk '/inet /{print $2}'); routes+="; ip route replace blackhole $gateway/32"; while read -r prefix; do routes+="; ip route replace $prefix via $gateway"; done < <(netstat -rn -f inet | awk -v dev="$iface" 'NR>4 && $NF == dev && $3 !~ /G/ && $1 != "default" && $1 ~ /\// {print $1}'); routes+="; ip route add blackhole 169.254.0.0/16"
    else echo "Error: pinned routing is unsupported on $host_os." >&2; exit 1; fi
    fs_reject_unsafe_chars "$routes" || exit 1
    # The network namespace exists only once the container starts, so it
    # starts attached before the pin exists; the generated bootstrap gates
    # the real command on the pin's own sentinel route until the helper
    # below installs it (see the bootstrap comment above). Attach runs in
    # the background so the pin helper can run concurrently with the gate it
    # is racing to close — `docker attach` never replays output written
    # before it connects, so waiting for the helper first would silently
    # drop anything the gated command prints before attach catches up.
    # `< /dev/stdin` is required: bash redirects a background command's
    # stdin from /dev/null in a non-interactive shell unless told otherwise,
    # and stdin is how a large prompt reaches the command (see the header) —
    # losing it would be a silent regression, not a loud one.
    "$CLI" start --attach --interactive "$CONTAINER" < /dev/stdin &
    attach_pid=$!
    "$CLI" run --rm --network "container:$CONTAINER" --cap-add=NET_ADMIN --user 0 --entrypoint /bin/bash "$IMAGE" -c "$routes" || { echo "Error: pin helper failed; command was not run." >&2; exit 1; }
    wait "$attach_pid" || true
else
    "$CLI" start --attach --interactive "$CONTAINER" || true
fi
started="$("$CLI" inspect -f '{{.State.StartedAt}}' "$CONTAINER")"; [[ "$started" != '0001-01-01T00:00:00Z' ]] || { echo "Error: container never started; no command exit code exists." >&2; exit 1; }
# docker wait blocks until the container actually stops and prints its exit
# status; by construction the container has already stopped by this line, so
# this returns immediately. `docker inspect .State.ExitCode` was used here
# before, but it reports 0 for a container that is STILL RUNNING, so any path
# where attach returned early or failed silently — the `|| true` above
# guarantees that is possible — would report success for a run that never
# finished. `docker wait`'s status is authoritative; the loose `|| true` on
# attach can no longer forge a passing exit code.
exit_code="$("$CLI" wait "$CONTAINER")"
exit "$exit_code"
