#!/usr/bin/env bash
# lkml-seats-resolve — Resolve which harness/model/thinking one lkml-mode
# persona seat runs on this machine, applying the machine seats file.
#
# Usage: lkml-seats-resolve check <personas-dir>
#        lkml-seats-resolve resolve <personas-dir> <persona> <fm-harness>
#                                            <fm-model> <fm-thinking>
#
# The seats file is the per-machine, per-persona override for the
# harness/model pins checked into each persona's frontmatter -- see
# skills/lkml-mode/SKILL.md, "Building a panel". Its path is
# $LKML_SEATS_FILE when set (the test hook, same pattern as
# LKML_SUMMARIZE_ENV_FILE), else ~/.config/fork-sandbox/lkml-seats.yaml.
#
# The seats file's schema is validated by lkml-seats-parse.py (the same
# "small python3 parser that fails with precise paths and emits
# tab-separated lines" precedent as fork-sandbox-preset-parse.py): a
# mapping with an optional `default` entry and an optional `personas`
# mapping, each carrying only `harness`, `model` and `thinking`.
#
# `check` validates the file (or its explicit absence) and exits 0.
# Launchers that may launch more than one persona call it once, before
# ANY launch, so a typo refuses the whole round instead of half a panel.
#
# `resolve` prints exactly four lines on stdout, one field per line
# (one-per-line rather than delimited: fields may be empty, and a
# whitespace IFS would collapse the empty middle fields):
#
#     <harness>
#     <model>
#     <thinking>
#     <announce>
#
# <announce> is empty unless the seats file changed the seat; it is the
# line the launcher prints on stderr with its own prefix, e.g. a launcher
# prints `lkml-round: seat core: pi-local (lkml-seats.yaml, was claude/opus)`
# so the operator can audit every seat a seats file moved.
#
# Precedence, per persona, key by key: the launcher's --model-override
# flag (which callers apply themselves, before calling this -- it wins
# over everything and keeps its own announcement) > a `personas.<p>`
# entry > `default:` > the persona frontmatter (the <fm-*> arguments).
# A model name belongs to its harness, the same rule as the preset
# compiler's harness override in fork-sandbox.sh: setting `harness` at
# any scope DROPS `model` from every lower-precedence scope --
# `personas.<p>.harness` drops both `default.model` and the frontmatter
# model, and `default.harness` drops the frontmatter model. A model
# survives only from the same scope as the effective harness or a
# higher-precedence one (a `personas.<p>.model` riding a `default:`
# harness is the operator composing both in one file, and stays allowed).
# Composing a lower scope's model onto a new harness is what asks the
# endpoint for a model it does not serve: a bare pi-local resolves its
# model from the endpoint, and a bare claude takes the harness default.
# `thinking` is harness-portable between pi flavors, so it inherits
# from frontmatter unless a seats entry sets it -- but it only reaches
# a seat on pi and pi-local (the launchers pass it via --pi-args, and
# nothing else). An EXPLICIT seats-file `thinking` on a persona whose
# resolved harness is not a pi flavor is a refusal in `resolve` (naming
# the persona, the key and the resolved harness): announcing it would
# report a no-op as a change. An INHERITED frontmatter `thinking` is
# dropped silently when the seats file moves the harness off pi, the
# same logic as the model drop -- it was written for the frontmatter's
# harness. The announce and launch lines mention `thinking` only when
# it will actually be passed.
#
# A missing file at the DEFAULT path is not an error: everything falls
# back to the frontmatter values verbatim (the fm-* arguments are
# printed unchanged, no announce). An LKML_SEATS_FILE that is set to a
# path with no file there IS an error -- the operator meant for a file
# to be there, and guessing that it was a typo would turn the typo into
# the frontmatter pins. An unreadable or unparseable file is always an
# error (the parser refuses loudly; we never fall back silently).

set -euo pipefail

usage() {
    sed -n '2,/^set -euo/{ /^#/s/^# \?//p }' "$0"
}

(( $# == 2 || $# == 6 )) || { usage >&2; exit 1; }
mode="$1"
personas_dir="$2"

seats_file="${LKML_SEATS_FILE:-$HOME/.config/fork-sandbox/lkml-seats.yaml}"

if [[ ! -e "$seats_file" ]]; then
    if [[ -n "${LKML_SEATS_FILE:-}" ]]; then
        echo "Error: LKML_SEATS_FILE points at '$seats_file', which does not" >&2
        echo "exist. Fix the path or unset it so the persona frontmatter" >&2
        echo "pins stand." >&2
        exit 1
    fi
    if [[ "$mode" == "resolve" ]]; then
        # No seats file: today's behavior, the frontmatter pins verbatim
        # (resolve mode's $4/$5/$6 are the fm-* arguments).
        printf '%s\n%s\n%s\n\n' "$4" "$5" "$6"
    fi
    exit 0
fi

script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
parsed="$(python3 "$script_dir/lkml-seats-parse.py" "$seats_file" "$seats_file" "$personas_dir")"

# The parser emits at most one line per (section, key); `default` lines
# are 3 fields, `personas` lines are 4. Collect the default: entry now;
# the per-persona pick happens after the mode split, where the persona
# argument exists.
def_harness="" def_model="" def_thinking=""
while IFS=$'\t' read -r f1 f2 f3 f4; do
    [[ "$f1" == "default" ]] || continue
    case "$f2" in
        harness) def_harness="$f3" ;;
        model) def_model="$f3" ;;
        thinking) def_thinking="$f3" ;;
    esac
done <<< "$parsed"

if [[ "$mode" == "check" ]]; then
    exit 0
fi

# resolve: $3 = persona, $4 = fm-harness, $5 = fm-model, $6 = fm-thinking
persona="$3" fm_harness="$4" fm_model="$5" fm_thinking="$6"
p_harness="" p_model="" p_thinking=""
while IFS=$'\t' read -r f1 f2 f3 f4; do
    [[ "$f1" == "personas" && "$f2" == "$persona" ]] || continue
    case "$f3" in
        harness) p_harness="$f4" ;;
        model) p_model="$f4" ;;
        thinking) p_thinking="$f4" ;;
    esac
done <<< "$parsed"

if [[ -n "$p_harness" ]]; then
    # The persona's own entry re-seats the harness: every model below
    # this scope belongs to its own harness and is DROPPED, not composed
    # -- only a model from this same entry may ride with it.
    harness="$p_harness"
    model="$p_model"
elif [[ -n "$def_harness" ]]; then
    # The default: entry re-seats the harness: its own model rides with
    # it (as does a higher-scope personas.<p> model, which the operator
    # composed in one file); the frontmatter's belongs to the
    # frontmatter's harness and is dropped, not inherited.
    harness="$def_harness"
    model="${p_model:-$def_model}"
else
    harness="$fm_harness"
    model="${p_model:-${def_model:-$fm_model}}"
fi
thinking=""
pi_flavor=0
case "$harness" in
    pi|pi-local) pi_flavor=1 ;;
esac
if (( pi_flavor )); then
    thinking="${p_thinking:-${def_thinking:-$fm_thinking}}"
else
    # thinking only reaches a seat via --pi-args, which the launchers
    # pass only to pi and pi-local. An explicit seats-file thinking
    # that lands on a non-pi seat would be announced as if it took
    # effect and then silently dropped, so it is refused; the
    # frontmatter's was written for the frontmatter's harness, so it
    # is dropped silently, the same logic as the model drop.
    if [[ -n "$p_thinking" || -n "$def_thinking" ]]; then
        echo "Error: seats file '$seats_file': persona '$persona' sets" >&2
        echo "'thinking', but its resolved harness is '$harness', which is" >&2
        echo "not a pi flavor. Thinking reaches a seat only via --pi-args" >&2
        echo "on pi and pi-local; remove the key or move the seat." >&2
        exit 1
    fi
fi

announce=""
changed=0
[[ "$harness" != "$fm_harness" ]] && changed=1
[[ "$model" != "$fm_model" ]] && changed=1
# A dropped frontmatter thinking (non-pi seat) is a silent drop, not a
# change to announce; on a pi seat it is compared as before.
(( pi_flavor )) && [[ "$thinking" != "$fm_thinking" ]] && changed=1
if (( changed )); then
    new_spec="$harness"
    [[ -n "$model" ]] && new_spec="$harness/$model"
    old_spec="$fm_harness"
    [[ -n "$fm_model" ]] && old_spec="$fm_harness/$fm_model"
    announce="seat $persona: $new_spec ($(basename -- "$seats_file"), was $old_spec)"
    # Mention thinking in the announce only when it will actually be
    # passed to the seat; the launchers drop it elsewhere, and
    # announcing a no-op is exactly what this refusal exists to stop.
    (( pi_flavor )) && [[ -n "$fm_thinking" && "$thinking" != "$fm_thinking" ]] \
        && announce="$announce; thinking $thinking, was $fm_thinking"
    (( pi_flavor )) && [[ -z "$fm_thinking" && -n "$thinking" ]] \
        && announce="$announce; thinking $thinking"
fi

printf '%s\n%s\n%s\n%s\n' "$harness" "$model" "$thinking" "$announce"
