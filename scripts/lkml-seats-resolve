#!/usr/bin/env bash
# lkml-seats-resolve — Resolve which harness/network/model/thinking one lkml-mode
# persona seat runs on this machine, applying the machine seats file.
#
# Usage: lkml-seats-resolve check <personas-dir>
#        lkml-seats-resolve active <personas-dir>
#        lkml-seats-resolve resolve <personas-dir> <persona> <fm-harness>
#                                            <fm-model> <fm-thinking>
#                                            <fm-network>
#
# The seats file is the per-machine, per-persona override for the
# harness/model pins checked into each persona's frontmatter -- see
# skills/lkml-mode/SKILL.md, "Building a panel". Its path is
# $LKML_SEATS_FILE when set (the test hook, same pattern as
# LKML_SUMMARIZE_ENV_FILE), else ~/.config/fork-sandbox/lkml-seats.yaml.
#
# The seats file's schema is validated by lkml-seats-parse.py (the same
# "small python3 parser that fails with precise paths and emits
# tab-separated lines" precedent as fork-sandbox-preset-parse.py): a
# mapping with an optional `default` entry and an optional `personas`
# mapping, each carrying only `harness`, `network`, `model` and `thinking`.
#
# `check` validates the file (or its explicit absence) and exits 0.
# Launchers that may launch more than one persona call it once, before
# ANY launch, so a typo refuses the whole round instead of half a panel.
#
# `active` reports whether a seats file is in effect at the owned path:
# exit 0 when the file exists, exit 1 when it does not (an explicit
# LKML_SEATS_FILE pointing at a missing path is still an error, not a
# mere inactivity). Launchers query it instead of re-deriving the path:
# the default and the set-but-empty-means-unset semantics live here
# only, so a launcher cannot drift into a silent frontmatter fallback
# the seats file was meant to prevent.
#
# `resolve` prints exactly five lines on stdout, one field per line
# (one-per-line rather than delimited: fields may be empty, and a
# whitespace IFS would collapse the empty middle fields):
#
#     <harness>
#     <model>
#     <thinking>
#     <network>
#     <announce>
#
# <announce> is empty unless the seats file changed the seat; it is the
# line the launcher prints on stderr with its own prefix, e.g. a launcher
# prints `lkml-round: seat core: pi, sealed (lkml-seats.yaml, was claude/opus)`
# so the operator can audit every seat a seats file moved.
#
# `harness: pi-local` is a permanent alias for `harness: pi` +
# `network: sealed` -- the fused spelling this two-axis form replaced.
# It is accepted forever, from any of the three input surfaces (persona
# frontmatter, `default:`, `personas.<p>:`), but never required and
# never documented: this script expands it to the two-axis form at the
# earliest point each surface's value is read, so nothing below that
# point ever sees `pi-local` as a harness. A same-entry `network: pinned`
# alongside `harness: pi-local` is a refusal (the alias already said
# sealed; the two contradict) -- lkml-seats-parse.py refuses this for
# the seats-file entries, and this script refuses it itself for the
# frontmatter argument, the one surface nothing else validates.
#
# Precedence, per persona, key by key: the launcher's --model-override
# flag (which callers apply themselves, before calling this -- it wins
# over everything and keeps its own announcement) > a `personas.<p>`
# entry > `default:` > the persona frontmatter (the <fm-*> arguments).
# A model name belongs to its harness, the same rule as the preset
# compiler's harness override in fork-sandbox.sh: setting `harness` at
# any scope DROPS `model` AND `network` from every lower-precedence
# scope -- `personas.<p>.harness` drops both `default.model`/`.network`
# and the frontmatter model/network, and `default.harness` drops the
# frontmatter model/network. A model or network survives only from the
# same scope as the effective harness or a higher-precedence one (a
# `personas.<p>.model` or `.network` riding a `default:` harness is the
# operator composing both in one file, and stays allowed). Composing a
# lower scope's model onto a new harness is what asks the endpoint for a
# model it does not serve: a bare SEALED pi resolves its model from the
# endpoint (a bare pinned pi has no such resolution and fork-sandbox.sh
# refuses it for lacking --model), and a bare claude takes the harness
# default. Composing a lower scope's network onto a new harness is what
# manufactures a launch failure out of two individually-valid files: a
# frontmatter `sealed` composed onto a seats-file `harness: claude` is an
# impossible seat, since fork-sandbox.sh refuses `--harness claude
# --network sealed` outright.
# `thinking` is harness-portable between pi flavors, so it inherits
# from frontmatter unless a seats entry sets it -- but it only reaches
# a seat on pi (the launchers pass it via --pi-args, and nothing else),
# regardless of that seat's network mode. An EXPLICIT seats-file
# `thinking` set at the effective harness's scope or a higher-precedence
# one on a persona whose resolved harness is not pi is a refusal in
# `resolve` (naming the key by its seats-file path -- `default.thinking`
# or `personas.<p>.thinking` -- plus the persona and the resolved
# harness): announcing it would report a no-op as a change. A `default:`
# thinking UNDER a `personas.<p>` harness is a lower-scope key, and the
# scope rule above drops it with the re-seat instead -- the same logic
# as the model drop -- as is an INHERITED frontmatter `thinking` when
# the seats file moves the harness off pi; both were written for a
# different seat. The announce and launch lines mention `thinking` only
# when it will actually be passed.
#
# A resolved seat whose harness is not `pi` and whose network is
# `sealed` is refused the same way: a sealed seat only makes sense on
# pi, and an EXPLICIT seats-file `network: sealed` set at the effective
# harness's scope or a higher-precedence one, on a persona whose
# resolved harness is not `pi`, is refused (naming `default.network` or
# `personas.<p>.network`, the persona, and the resolved harness). A
# `network: sealed` arriving from a lower scope cannot reach this check,
# because the drop rule above already dropped it with its re-seat. This
# refusal only covers the seats-file surfaces -- a persona whose OWN
# frontmatter pairs a non-pi harness with a sealed network, on a machine
# with no seats file at all, never reaches `resolve` (it is never
# called); callers that may launch more than one persona must catch that
# case themselves, in their own pre-pass, before any seat launches.
#
# A missing file at the DEFAULT path is not an error: everything falls
# back to the frontmatter values verbatim (the fm-* arguments are
# printed unchanged, no announce). An LKML_SEATS_FILE that is set to a
# path with no file there IS an error -- the operator meant for a file
# to be there, and guessing that it was a typo would turn the typo into
# the frontmatter pins. An unreadable or unparseable file is always an
# error (the parser refuses loudly; we never fall back silently).

set -euo pipefail

usage() {
    sed -n '2,/^set -euo/{ /^#/s/^# \?//p }' "$0"
}

if [[ "${1-}" == -h || "${1-}" == --help ]]; then
    usage
    exit 0
fi

(( $# == 2 || $# == 7 )) || { usage >&2; exit 1; }
mode="$1"
personas_dir="$2"

if [[ "$mode" == "resolve" ]]; then
    persona="$3" fm_harness="$4" fm_model="$5" fm_thinking="$6" fm_network="${7:-}"
    # D2: pi-local is a frontmatter input surface too, and nothing else
    # validates a frontmatter harness+network pair (lkml-seats-parse.py
    # only validates the seats FILE), so resolve does it here, at the
    # earliest point the frontmatter argument is read. A frontmatter
    # `network` outside the whitelist (a typo like 'seald') must refuse
    # here too -- every consumer downstream compares it with
    # `== "sealed"`, so an unrecognized value fails OPEN (networked)
    # rather than refusing, the opposite of what a seal typo should do.
    case "$fm_network" in
        ""|pinned|sealed) ;;
        *)
            echo "Error: persona '$persona' frontmatter: 'network' takes 'pinned'" >&2
            echo "or 'sealed', not '$fm_network'." >&2
            exit 1
            ;;
    esac
    if [[ "$fm_harness" == "pi-local" ]]; then
        if [[ "$fm_network" == "pinned" ]]; then
            echo "Error: persona '$persona' frontmatter: harness 'pi-local' is" >&2
            echo "already sealed; 'network' may only be 'sealed' or omitted," >&2
            echo "not 'pinned'." >&2
            exit 1
        fi
        fm_harness="pi"
        fm_network="sealed"
    fi
fi

seats_file="${LKML_SEATS_FILE:-$HOME/.config/fork-sandbox/lkml-seats.yaml}"

if [[ ! -e "$seats_file" ]]; then
    if [[ -n "${LKML_SEATS_FILE:-}" ]]; then
        echo "Error: LKML_SEATS_FILE points at '$seats_file', which does not" >&2
        echo "exist. Fix the path or unset it so the persona frontmatter" >&2
        echo "pins stand." >&2
        exit 1
    fi
    if [[ "$mode" == "active" ]]; then
        exit 1
    fi
    if [[ "$mode" == "resolve" ]]; then
        # No seats file: today's behavior, the frontmatter pins verbatim
        # (already pi-local-expanded above).
        printf '%s\n%s\n%s\n%s\n\n' "$fm_harness" "$fm_model" "$fm_thinking" "$fm_network"
    fi
    exit 0
fi

script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

if [[ "$mode" == "active" ]]; then
    # Presence is all this mode answers; `check` does the parsing.
    exit 0
fi

parsed="$(python3 "$script_dir/lkml-seats-parse.py" "$seats_file" "$seats_file" "$personas_dir")"

# The parser emits at most one line per (section, key); `default` lines
# are 3 fields, `personas` lines are 4. Collect the default: entry now;
# the per-persona pick happens after the mode split, where the persona
# argument exists.
def_harness="" def_model="" def_thinking="" def_network=""
while IFS=$'\t' read -r f1 f2 f3 f4; do
    [[ "$f1" == "default" ]] || continue
    case "$f2" in
        harness) def_harness="$f3" ;;
        network) def_network="$f3" ;;
        model) def_model="$f3" ;;
        thinking) def_thinking="$f3" ;;
    esac
done <<< "$parsed"
# Already contradiction-checked by lkml-seats-parse.py, so just expand.
[[ "$def_harness" == "pi-local" ]] && { def_harness="pi"; def_network="sealed"; }

if [[ "$mode" == "check" ]]; then
    exit 0
fi

p_harness="" p_model="" p_thinking="" p_network=""
while IFS=$'\t' read -r f1 f2 f3 f4; do
    [[ "$f1" == "personas" && "$f2" == "$persona" ]] || continue
    case "$f3" in
        harness) p_harness="$f4" ;;
        network) p_network="$f4" ;;
        model) p_model="$f4" ;;
        thinking) p_thinking="$f4" ;;
    esac
done <<< "$parsed"
[[ "$p_harness" == "pi-local" ]] && { p_harness="pi"; p_network="sealed"; }

if [[ -n "$p_harness" ]]; then
    # The persona's own entry re-seats the harness: every model/network
    # below this scope belongs to its own harness and is DROPPED, not
    # composed -- only a model/network from this same entry may ride
    # with it.
    harness="$p_harness"
    model="$p_model"
    network="$p_network"
elif [[ -n "$def_harness" ]]; then
    # The default: entry re-seats the harness: its own model/network
    # rides with it (as does a higher-scope personas.<p> model/network,
    # which the operator composed in one file); the frontmatter's
    # belongs to the frontmatter's harness and is dropped, not inherited.
    harness="$def_harness"
    model="${p_model:-$def_model}"
    network="${p_network:-$def_network}"
else
    harness="$fm_harness"
    model="${p_model:-${def_model:-$fm_model}}"
    network="${p_network:-${def_network:-$fm_network}}"
fi
thinking=""
pi_flavor=0
[[ "$harness" == "pi" ]] && pi_flavor=1
if (( pi_flavor )); then
    thinking="${p_thinking:-${def_thinking:-$fm_thinking}}"
else
    # thinking only reaches a seat via --pi-args, which the launchers
    # pass only to pi. An explicit seats-file thinking set
    # at the effective harness's scope or a higher-precedence one would
    # be announced as if it took effect and then silently dropped, so
    # it is refused; the frontmatter's was written for the
    # frontmatter's harness, and a default: thinking under a
    # personas.<p> harness was re-seated out of scope (the same logic
    # as the model drop), so both are dropped silently.
    bad_key=""
    if [[ -n "$p_thinking" ]]; then
        # the persona's own scope is at or above the effective
        # harness's scope, wherever that harness was set
        bad_key="personas.$persona.thinking"
    elif [[ -z "$p_harness" && -n "$def_thinking" ]]; then
        # only when no persona-scope harness re-seats the seat below it
        bad_key="default.thinking"
    fi
    if [[ -n "$bad_key" ]]; then
        echo "Error: seats file '$seats_file': $bad_key sets 'thinking'" >&2
        echo "for persona '$persona', but its resolved harness is '$harness'," >&2
        echo "which is not a pi flavor. Thinking reaches a seat only via" >&2
        echo "--pi-args on pi; remove the key or move the seat." >&2
        exit 1
    fi
fi

if [[ "$harness" != "pi" && "$network" == "sealed" ]]; then
    # A sealed network only makes sense on pi; an explicit seats-file
    # network at the effective harness's scope or higher would be
    # announced as taking effect and then produce a launch that
    # fork-sandbox.sh itself refuses, so it is caught here instead. A
    # sealed network arriving from a lower scope cannot reach this
    # check -- the drop rule above already dropped it with its re-seat.
    bad_key=""
    if [[ -n "$p_network" ]]; then
        bad_key="personas.$persona.network"
    elif [[ -z "$p_harness" && -n "$def_network" ]]; then
        bad_key="default.network"
    fi
    if [[ -n "$bad_key" ]]; then
        echo "Error: seats file '$seats_file': $bad_key sets 'network' to" >&2
        echo "'sealed' for persona '$persona', but its resolved harness is" >&2
        echo "'$harness', not 'pi'. A sealed seat must run on pi; remove the" >&2
        echo "key or move the seat." >&2
        exit 1
    fi
fi

announce=""
changed=0
[[ "$harness" != "$fm_harness" ]] && changed=1
[[ "$model" != "$fm_model" ]] && changed=1
# "" and "pinned" are the same seat spelled two ways (an omitted
# frontmatter network defaults to pinned, same as an explicit one) --
# compare normalized copies so an explicit `network: pinned` that only
# restates the default is not announced as a change.
network_norm="${network:-pinned}"
fm_network_norm="${fm_network:-pinned}"
[[ "$network_norm" != "$fm_network_norm" ]] && changed=1
# A dropped frontmatter thinking (non-pi seat) is a silent drop, not a
# change to announce; on a pi seat it is compared as before.
(( pi_flavor )) && [[ "$thinking" != "$fm_thinking" ]] && changed=1
if (( changed )); then
    new_spec="$harness"
    [[ -n "$model" ]] && new_spec="$harness/$model"
    [[ "$network" == "sealed" ]] && new_spec="$new_spec, sealed"
    old_spec="$fm_harness"
    [[ -n "$fm_model" ]] && old_spec="$fm_harness/$fm_model"
    [[ "$fm_network" == "sealed" ]] && old_spec="$old_spec, sealed"
    announce="seat $persona: $new_spec ($(basename -- "$seats_file"), was $old_spec)"
    # Mention thinking in the announce only when it will actually be
    # passed to the seat; the launchers drop it elsewhere, and
    # announcing a no-op is exactly what this refusal exists to stop.
    (( pi_flavor )) && [[ -n "$fm_thinking" && "$thinking" != "$fm_thinking" ]] \
        && announce="$announce; thinking $thinking, was $fm_thinking"
    (( pi_flavor )) && [[ -z "$fm_thinking" && -n "$thinking" ]] \
        && announce="$announce; thinking $thinking"
fi

printf '%s\n%s\n%s\n%s\n%s\n' "$harness" "$model" "$thinking" "$network" "$announce"
