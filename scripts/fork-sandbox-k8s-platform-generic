#!/usr/bin/env bash
# fork-sandbox-k8s-platform-generic -- the portable Kubernetes platform plugin
#
# Usage: fork-sandbox-k8s-platform-generic --capabilities
#        fork-sandbox-k8s-platform-generic render-policy --namespace NS \
#                --agent-label KEY=VAL --proxy-label KEY=VAL --proxy-port PORT \
#                [--allow-namespace NS[:PORT]]...
#        fork-sandbox-k8s-platform-generic render-grant --namespace NS \
#                --name NAME --agent-label KEY=VAL [--label KEY=VAL]... \
#                --allow-namespace NS[:PORT] [--allow-namespace NS[:PORT]]...
#
# Implements the contract in docs/k8s-platform.md: three verbs, nothing else.
# --capabilities prints what this platform can do, to stdout, and touches
# nothing. render-policy prints the NetworkPolicy YAML that seals the agent
# pod's egress, to stdout, and touches nothing. render-grant prints ONE
# additional, additive NetworkPolicy that widens a single run's egress to
# the given namespaces, named NAME rather than the seal's fixed name --
# neither verb ever runs kubectl or reaches a cluster. fork-sandbox-k8s.sh
# applies the result.
#
# This is the one platform v1 ships: plain Kubernetes NetworkPolicy, the
# dialect Calico, Cilium, kube-router, Antrea and Weave all honour. It is
# named generic, not after a cluster or a CNI, because it is not tied to
# one -- it is the portable baseline every other platform is measured
# against.
#
#   policy=networkpolicy   the dialect render-policy emits
#   icmp=unfiltered        plain NetworkPolicy has no field that denies
#                          ICMP, so a pod here can ping-sweep whatever its
#                          egress rules leave reachable, and can tunnel data
#                          out in echo-request bodies regardless of what the
#                          policy says. This is not a shortcut -- it is the
#                          truth about the dialect, and a richer platform
#                          (Cilium's CiliumNetworkPolicy, say) is where this
#                          first becomes `filtered`.
#   dns=recursive          DNS egress is not content-filtered here.
#   runtimeclass=none      no stronger isolation class is offered.
#   grant=render-grant     this platform supports render-grant, the verb
#                          that widens one run's egress without touching
#                          the shared seal. A platform that omits this key
#                          does not support per-run grants at all.
#
# render-policy's output seals the agent pod to two destinations by default:
# DNS in kube-system, and the proxy on the given label and port. It has no
# opinion about the proxy's own policy -- that one is ordinary and portable
# and lives as a static file in manifests/k8s/ instead.
#
# --allow-namespace is the one thing that widens that seal, and it is a
# CALLER decision, never a platform one: fork-sandbox-k8s.sh passes it from
# K8S_AGENT_ALLOW_NS in this machine's k8s.env, so the set of extra
# destinations is site configuration that the caller can announce, log and
# dry-run, rather than something a plugin decides privately. That placement
# is the whole point. A plugin that widened by reading its own config would
# be invisible to the egress gate, whose fixed checks (denied probe
# unreachable, proxy reachable, ICMP where declared) touch no widened
# namespace, so it passes either way -- and would make this platform's
# --capabilities answer -- the thing docs/k8s-platform.md exists to make
# sayable -- quietly false.
#
# Each entry renders a namespaceSelector on the standard
# kubernetes.io/metadata.name label, NOT an ipBlock. kube-proxy DNATs a
# ClusterIP to a pod IP BEFORE egress policy is evaluated on most CNIs, so an
# ipBlock naming a Service's ClusterIP validates fine and then never matches;
# a namespaceSelector matches the destination pod's own namespace label,
# which survives the DNAT. This is the same construct, and the same reasoning,
# as K8S_PROXY_ALLOW_NS applies to the proxy's own policy.
#
# The port is optional: a site pointing at an in-cluster Service may not know
# (or want to pin) which port it listens on, and NetworkPolicy treats a rule
# with no `ports:` key as every port and protocol.
#
# Mind the protocol asymmetry that creates. A NAMED port renders
# `protocol: TCP` and permits nothing else, so the narrower-looking form is
# the one that silently drops UDP -- a StatsD or syslog service named with its
# port is announced as opened and then never receives a datagram. Omit the
# port for anything not purely TCP.

set -euo pipefail

if [[ "${1-}" == -h || "${1-}" == --help ]]; then
    sed -n '2,/^$/p' "$(readlink -f "${BASH_SOURCE[0]}")" | sed 's/^# \{0,1\}//'
    exit 0
fi

# Checked first, before anything else, exactly as sandbox-backend-* checks
# --capabilities before any required-option validation: a caller asking what
# this platform can do must never be refused for lacking render-policy's
# options.
if [[ "${1-}" == --capabilities ]]; then
    cat <<'EOF'
policy=networkpolicy
icmp=unfiltered
dns=recursive
runtimeclass=none
grant=render-grant
EOF
    exit 0
fi

verb="${1-}"
if [[ -z "$verb" ]]; then
    echo "Error: no verb given. Use --capabilities, render-policy or render-grant." >&2
    exit 1
fi
shift

case "$verb" in
render-policy|render-grant)
    ;;
*)
    echo "Error: unknown verb '$verb'. Use --capabilities, render-policy or render-grant." >&2
    exit 1
    ;;
esac

namespace=""
grant_name=""
agent_label=""
proxy_label=""
proxy_port=""
labels=()
allow_ns=()
allow_port=()

while (( $# )); do
    case "$1" in
        --namespace) namespace="${2:?--namespace requires a name}"; shift 2 ;;
        --name) grant_name="${2:?--name requires a name}"; shift 2 ;;
        --agent-label) agent_label="${2:?--agent-label requires KEY=VAL}"; shift 2 ;;
        --proxy-label) proxy_label="${2:?--proxy-label requires KEY=VAL}"; shift 2 ;;
        --proxy-port) proxy_port="${2:?--proxy-port requires a port number}"; shift 2 ;;
        --label) labels+=("${2:?--label requires KEY=VAL}"); shift 2 ;;
        --allow-namespace)
            entry="${2:?--allow-namespace requires NS[:PORT]}"
            if [[ "$entry" == *:* ]]; then
                ns="${entry%:*}"
                port="${entry##*:}"
                if [[ -z "$port" ]]; then
                    echo "Error: --allow-namespace '$entry' has a trailing ':' with no" >&2
                    echo "port after it -- omit the ':' entirely for every port, or name" >&2
                    echo "one, such as '$ns:8000'." >&2
                    exit 1
                fi
            else
                ns="$entry"
                port=""
            fi
            # The 63-character cap is the label-VALUE limit the Kubernetes
            # API enforces on kubernetes.io/metadata.name. Without it an
            # over-long namespace renders clean here and under --dry-run, and
            # is refused only at kubectl apply -- the least useful place.
            if [[ ! "$ns" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ || ${#ns} -gt 63 ]]; then
                echo "Error: --allow-namespace '$entry' does not name a valid" >&2
                echo "namespace ('$ns') -- it must match" >&2
                echo '[a-z0-9]([a-z0-9-]*[a-z0-9])?, the standard' >&2
                echo "kubernetes.io/metadata.name label shape, and be at most" >&2
                echo "63 characters." >&2
                exit 1
            fi
            # Forced base 10 (10#$port), as parse_proxy_allow_ns does for the
            # identical input: plain (( port < 1 )) hands bash arithmetic a
            # string it reads as a C-style integer literal, so a leading zero
            # is octal -- "08"/"09" are not valid octal digits at all and
            # abort with a bash arithmetic error instead of this message,
            # leaving the port unvalidated and rendered as-is.
            if [[ -n "$port" ]] && { [[ ! "$port" =~ ^[0-9]{1,5}$ ]] || (( 10#$port < 1 || 10#$port > 65535 )); }; then
                echo "Error: --allow-namespace '$entry' has an invalid port '$port'" >&2
                echo "-- must be 1-65535." >&2
                exit 1
            fi
            # Normalized to canonical decimal so a leading-zero input like
            # "08" never renders as a string the Kubernetes API reads as a
            # named port.
            [[ -n "$port" ]] && port="$(( 10#$port ))"
            allow_ns+=("$ns")
            allow_port+=("$port")
            shift 2
            ;;
        *) echo "Error: unknown option '$1' for $verb." >&2; exit 1 ;;
    esac
done

case "$verb" in
render-policy)
    required_opts=(namespace agent_label proxy_label proxy_port)
    ;;
render-grant)
    required_opts=(namespace grant_name agent_label)
    ;;
esac

for required in "${required_opts[@]}"; do
    if [[ -z "${!required}" ]]; then
        flag="--${required//_/-}"
        [[ "$required" == grant_name ]] && flag="--name"
        if [[ "$verb" == render-policy ]]; then
            echo "Error: render-policy requires --namespace, --agent-label," >&2
            echo "--proxy-label and --proxy-port. Missing: $flag." >&2
        else
            echo "Error: render-grant requires --namespace, --name," >&2
            echo "--agent-label and at least one --allow-namespace." >&2
            echo "Missing: $flag." >&2
        fi
        exit 1
    fi
done

if [[ "$verb" == render-grant && ${#allow_ns[@]} -eq 0 ]]; then
    echo "Error: render-grant requires at least one --allow-namespace." >&2
    exit 1
fi

pair_names=(agent_label)
[[ "$verb" == render-policy ]] && pair_names+=(proxy_label)
for pair_name in "${pair_names[@]}"; do
    pair="${!pair_name}"
    if [[ "$pair" != *=* || -z "${pair%%=*}" ]]; then
        echo "Error: --${pair_name//_/-} takes KEY=VAL, not '$pair'." >&2
        exit 1
    fi
done

for pair in "${labels[@]}"; do
    if [[ "$pair" != *=* || -z "${pair%%=*}" ]]; then
        echo "Error: --label takes KEY=VAL, not '$pair'." >&2
        exit 1
    fi
done

if [[ "$verb" == render-policy && ! "$proxy_port" =~ ^[0-9]+$ ]]; then
    echo "Error: --proxy-port takes a port number, not '$proxy_port'." >&2
    exit 1
fi

agent_key="${agent_label%%=*}"
agent_val="${agent_label#*=}"
proxy_key="${proxy_label%%=*}"
proxy_val="${proxy_label#*=}"

# Shared by render-policy's --allow-namespace tail and render-grant's whole
# egress list, so the two dialects of "widen egress to a namespace" cannot
# drift apart. An empty port omits the `ports:` key entirely rather than
# rendering an empty list -- NetworkPolicy reads a rule with no `ports:` key
# as every port and protocol, whereas `ports: []` would match nothing.
render_allow_ns_rules() {
    local i
    for (( i = 0; i < ${#allow_ns[@]}; i++ )); do
        cat <<EOF
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ${allow_ns[$i]}
EOF
        if [[ -n "${allow_port[$i]}" ]]; then
            cat <<EOF
      ports:
        - protocol: TCP
          port: ${allow_port[$i]}
EOF
        fi
    done
}

if [[ "$verb" == render-policy ]]; then
    # Default-deny is implicit: policyTypes names both Ingress and Egress,
    # and an empty ingress list denies all ingress. The agent pod needs
    # none -- it is never dialed into, only fetched from over kubectl exec,
    # which does not cross this policy at all.
    cat <<EOF
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: fork-sandbox-agent-egress
  namespace: $namespace
spec:
  podSelector:
    matchLabels:
      $agent_key: $agent_val
  policyTypes:
    - Ingress
    - Egress
  ingress: []
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
    - to:
        - podSelector:
            matchLabels:
              $proxy_key: $proxy_val
      ports:
        - protocol: TCP
          port: $proxy_port
EOF
    # Appended after the two sealed rules above, so output stays
    # byte-identical to a no --allow-namespace run whenever none is passed.
    render_allow_ns_rules
else
    # render-grant is purely additive: policyTypes names Egress only, with
    # no ingress: key at all, so ingress stays ungoverned by this object and
    # the shared seal (render-policy's output, applied separately) keeps
    # doing that job. This object must never carry render-policy's fixed
    # name -- it would replace the seal instead of adding to it.
    cat <<EOF
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: $grant_name
  namespace: $namespace
EOF
    if (( ${#labels[@]} > 0 )); then
        echo "  labels:"
        for pair in "${labels[@]}"; do
            echo "    ${pair%%=*}: ${pair#*=}"
        done
    fi
    cat <<EOF
spec:
  podSelector:
    matchLabels:
      $agent_key: $agent_val
  policyTypes:
    - Egress
  egress:
EOF
    render_allow_ns_rules
fi
